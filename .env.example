# Copy to .env to set these for `pnpm dev` and `generate-guide`.

# Which account the agent CLIs run guides as: the folder that holds each CLI's
# login and settings. Leave unset for the defaults, ~/.claude and ~/.codex.
# CLAUDE_CONFIG_DIR=/Users/you/.claude-work
# CODEX_HOME=/Users/you/.codex-work

# Where Proofroom keeps its database, clones and worktrees (default ~/.proofroom).
# PROOFROOM_HOME=/Users/you/.proofroom

# The server's port (default 4790).
# PROOFROOM_PORT=4790
